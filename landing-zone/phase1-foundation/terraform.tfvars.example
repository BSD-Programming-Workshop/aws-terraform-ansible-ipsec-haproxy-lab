# Phase 1 Foundation Configuration
# Copy this to terraform.tfvars and customize for your organization

# Organization Configuration
organization_name = "Unix-Organization"
home_region      = "us-east-1"
governed_regions = ["us-east-1"]

# Logging Configuration
log_retention_days        = 365
access_log_retention_days = 90
  
# Account Email Addresses (MUST be unique across all AWS)
# You need 7 unique email addresses total for all accounts
# 
# Proton Pass Aliases (Recommended):
# Create aliases in Proton Pass that forward to your main Proton email
# aws-log-archive@[your-alias-domain]
# aws-audit@[your-alias-domain]
# aws-security@[your-alias-domain]
# aws-dev@[your-alias-domain]
# aws-staging@[your-alias-domain]
# aws-prod@[your-alias-domain]
# aws-network@[your-alias-domain]

log_archive_email      = "aws-log-archive@your-alias-domain.com"
audit_email           = "aws-audit@your-alias-domain.com"
security_tooling_email = "aws-security@your-alias-domain.com"
unix_dev_email     = "aws-dev@your-alias-domain.com"
unix_staging_email = "aws-staging@your-alias-domain.com"
unix_prod_email    = "aws-prod@your-alias-domain.com"
network_email         = "aws-network@your-alias-domain.com"

# Budget alerts (required for cost controls section)
budget_email  = "you@example.com"  # Recipient of budget alerts
budget_amount = 20                  # USD per month threshold
