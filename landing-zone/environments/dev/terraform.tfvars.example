# Example Terraform variables for Development Environment
# Copy this file to terraform.tfvars and customize the values

# Project / account
project_name    = "unix-workload"
dev_account_id  = "123456789012"        # Replace with value from phase1 outputs
aws_region      = "us-east-1"
availability_zone = "us-east-1b"        # Known-good for FreeBSD example

# Networking
vpc_cidr            = "10.1.0.0/16"
public_subnet_cidr  = "10.1.1.0/24"
workstation_cidr    = "203.0.113.4/32"   # Replace with your actual public IP/32 (https://checkip.amazonaws.com)

# AMI and instance (FreeBSD)
custom_ami_id       = "ami-xxxxxxxxxxxxxxxxx"   # FreeBSD AMI ID you subscribed to in Marketplace (e.g., ami-07a38014679e554b7 in us-east-1)
instance_type       = "t3.micro"
metadata_http_tokens = "required"

# Storage
root_volume_type    = "gp3"
root_volume_size    = 10

# SSH key (paste your public key content here)
public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA..."

# Optional: RHEL deployment (uncomment and set AMI if you want RHEL alongside FreeBSD)
# rhel_ami_id = "ami-0123456789abcdef0"
