# Example Terraform variables for Staging Environment
# Copy this file to terraform.tfvars and customize the values

# Project configuration
project_name = "unix-workload"
aws_region   = "us-east-1"
availability_zone = "us-east-1a"

# Operating System Configuration
operating_system = "freebsd"  # Options: "freebsd" or "rhel"
custom_ami_id    = ""         # Required for RHEL gold images
workload_type    = "ipsec-server"

# Account ID for staging environment (get from phase1 outputs)
staging_account_id = "123456789013"

# Networking configuration
vpc_cidr           = "10.2.0.0/16"
public_subnet_cidr = "10.2.1.0/24"
workstation_cidr   = "203.0.113.0/24"  # Replace with your actual IP/CIDR

# EC2 configuration
instance_type      = "t3.large"
root_volume_size   = 20
root_volume_type   = "gp3"

# SSH key (paste your public key content here)
public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... your-public-key-here"

# Example for RHEL deployment:
# operating_system = "rhel"
# custom_ami_id    = "ami-0123456789abcdef0"  # Your RHEL gold image AMI ID
